generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                            String                          @id @default(cuid())
  email                         String                          @unique
  name                          String?
  passwordHash                  String
  role                          UserRole                        @default(USER)
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt
  sessionVersion                Int                             @default(0)
  emailChangeVerifications      EmailChangeVerification[]
  passwordChangeVerifications   PasswordChangeVerification[]
  passwordResetTokens           PasswordResetToken[]

  @@map("users")
}

model Product {
  id          String         @id @default(cuid())
  name        String
  description String?
  price       Float          @default(0)
  imageUrl    String?
  imageKey    String?
  category    String?
  isActive    Boolean        @default(true)
  abVariant   ABVariant      @default(A)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  events      ABTestEvent[]
  images      ProductImage[]

  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  imageUrl  String
  imageKey  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, order])
  @@map("product_images")
}

model ABTestEvent {
  id        String      @id @default(cuid())
  productId String
  variant   ABVariant
  eventType ABEventType
  sessionId String?
  createdAt DateTime    @default(now())
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("ab_test_events")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model Video {
  id          String   @id @default(cuid())
  title       String
  description String?
  videoUrl    String
  videoKey    String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("videos")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model EmailChangeVerification {
  id         String    @id @default(cuid())
  userId     String
  newEmail   String
  codeHash   String
  expiresAt  DateTime
  used       Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([newEmail, used])
  @@index([userId, used, expiresAt])
  @@map("email_change_verifications")
}

model PasswordChangeVerification {
  id              String    @id @default(cuid())
  userId          String
  newPasswordHash String
  codeHash        String
  expiresAt       DateTime
  used            Boolean   @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, used, expiresAt])
  @@map("password_change_verifications")
}

enum UserRole {
  ADMIN
  USER
}

enum ABVariant {
  A
  B
  C
}

enum ABEventType {
  VIEW
  CLICK
  CONVERSION
}

model Banner {
  id          String     @id @default(cuid())
  type        BannerType
  title       String?
  subtitle    String?
  description String?
  imageUrl    String
  imageKey    String?
  order       Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("banners")
}

enum BannerType {
  HERO
  PROFILE
}

model SearchLog {
  id        String   @id @default(cuid())
  query     String
  createdAt DateTime @default(now())

  @@map("search_logs")
}
